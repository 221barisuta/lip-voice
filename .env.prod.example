# prod 環境の設定テンプレート。コピーして .env.prod を作り、値を埋める。
# prod は利用者本人のアカウント内の GCP プロジェクトを指す。
# .env.prod は git 管理外。値をリポジトリに書かないこと。

# --- GCP ---
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GCS_BUCKET=
BQ_DATASET=lip_voice

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=

# --- server ---
ALLOWED_ORIGINS=
ALLOWED_EMAILS=
CLOUD_RUN_SERVICE=lip-voice-api
TRAIN_JOB_NAME=lip-voice-train
