# dev 環境の設定テンプレート。コピーして .env.dev を作り、値を埋める。
# .env.dev は git 管理外。値をリポジトリに書かないこと。

# --- GCP ---
GCP_PROJECT_ID=            # 例: lip-voice-dev（専用プロジェクト。他用途と同居させない）
GCP_REGION=                # 例: us-east1（Storage バケットのロケーションに合わせる）
GCS_BUCKET=                # Firebase Storage のデフォルトバケット名（例: <project-id>.firebasestorage.app）
FIRESTORE_LOCATION=        # 例: nam5
BQ_DATASET=lip_voice       # 評価集計用データセット

# --- Firebase (ブラウザ側。VITE_ 接頭辞で web に渡る) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=         # Cloud Run の URL。ローカル開発時は http://localhost:8000

# --- server ---
ALLOWED_ORIGINS=http://localhost:5173   # CORS。本番は Hosting の URL
TRAIN_JOB_NAME=lip-voice-train          # Cloud Run Jobs のジョブ名
