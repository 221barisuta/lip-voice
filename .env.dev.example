# dev 環境の設定テンプレート。コピーして .env.dev を作り、値を埋める。
# .env.dev は git 管理外。値をリポジトリに書かないこと。

# --- GCP ---
GCP_PROJECT_ID=            # 例: lip-voice-dev（専用プロジェクト。他用途と同居させない）
GCP_REGION=asia-northeast1   # Cloud Run のリージョン。Firestore・バケットと同じ地域に近い所を選ぶ（例: バケットが us-east1 なら us-east1）
GCS_BUCKET=                # 録画・モデルの保存先バケット名
BQ_DATASET=lip_voice       # 評価集計用データセット

# --- Firebase (ブラウザ側。VITE_ 接頭辞で web に渡る) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=         # 配置時は空でよい（deploy.sh が Cloud Run の URL を使う）。ローカル開発時は http://localhost:8000

# --- server ---
ALLOWED_ORIGINS=http://localhost:5173   # CORS の追加許可。Hosting の URL は deploy.sh が自動で加える
ALLOWED_EMAILS=                         # ログインを許可する Google アカウントのメール（カンマ区切り）。空だと誰も通れない
CLOUD_RUN_SERVICE=lip-voice-api         # Cloud Run のサービス名
TRAIN_JOB_NAME=lip-voice-train          # Cloud Run Jobs のジョブ名

# --- ローカル検証用（配置時は必ず空）---
VITE_AUTH_EMULATOR_URL=    # Firebase Auth エミュレータを使う時だけ。例: http://127.0.0.1:9099
