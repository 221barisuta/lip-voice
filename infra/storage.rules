rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 録画・モデルは本人のみ読める。書き込みはサーバー経由のみ。
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /models/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
